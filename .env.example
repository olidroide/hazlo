# Database
HAZLO_DATABASE_URL=postgresql+asyncpg://hazlo:hazlo@localhost:5433/hazlo

# Auth
HAZLO_ADMIN_USER=admin
HAZLO_ADMIN_PASSWORD=<strong-password>

# Security
HAZLO_SECRET_KEY=<generate-with-python-secrets>
HAZLO_VERIFY_SSL=true
# HAZLO_CA_BUNDLE=/path/to/certifi+corporate-ca-bundle.pem  # required behind corporate proxy

# App
HAZLO_AUTO_MIGRATE=1
HAZLO_AUTO_APPROVE_THRESHOLD=0.95

# Prefect
HAZLO_PREFECT_API_URL=http://localhost:4200/api
HAZLO_PREFECT_WORK_POOL_NAME=local-pool
HAZLO_PREFECT_INGEST_FLOW_TIMEOUT_SECONDS=1500
HAZLO_PREFECT_FETCH_SOURCE_TASK_TIMEOUT_SECONDS=1200

# RSS
HAZLO_RSS_MAX_RESULTS=30

# RAW document storage (filesystem by default, configurable for S3/R2)
HAZLO_RAW_STORAGE_BACKEND=local
HAZLO_RAW_LOCAL_PATH=./data/raw

# Feature flags
HAZLO_UNIFIED_REPARSE=false
